{
  "name": "inazuma-pwsh",
  "displayName": "Zuma MCP - Copilot Chat Log & Context Optimizer",
  "description": "Stop Copilot from loading huge build and test logs. Get concise failures, targeted file reads, task anchors, and safe handoffs for AI coding.",
  "version": "0.12.1",
  "publisher": "ShunsukeF",
  "icon": "media/icon.png",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/furukawa658/inazuma-pwsh.git",
    "directory": "vscode-extension"
  },
  "bugs": {
    "url": "https://github.com/furukawa658/inazuma-pwsh/issues"
  },
  "homepage": "https://github.com/furukawa658/inazuma-pwsh#readme",
  "engines": { "vscode": "^1.101.0" },
  "categories": ["AI", "Chat", "Testing"],
  "keywords": [
    "mcp", "model context protocol", "agent", "copilot", "context",
    "pwsh", "powershell", "diagnostics", "dotnet", "sarif", "trx",
    "playwright", "vitest", "bun", "pytest", "eslint", "tsc", "log"
  ],
  "extensionKind": ["ui"],
  "main": "./extension.js",
  "activationEvents": ["onStartupFinished"],
  "capabilities": {
    "untrustedWorkspaces": { "supported": false },
    "virtualWorkspaces": false
  },
  "contributes": {
    "configuration": {
      "title": "Zuma MCP",
      "properties": {
        "inazumaPwsh.pwshPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to an installed pwsh (pwsh.exe on Windows). Leave empty to use INAZUMA_PWSH_PATH or search PATH. An invalid explicit path fails without fallback. Restart the MCP server after changing this setting."
        },
        "inazumaPwsh.executionGuard.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Enable Zuma execution-loop detection and test execution policy checks."
        },
        "inazumaPwsh.handoff.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Allow prepare_handoff to read an explicitly selected VS Code chat session and return a bounded local summary. Chat text is never uploaded or saved by Zuma."
        },
        "inazumaPwsh.executionGuard.mode": {
          "type": "string",
          "enum": ["manual", "incremental", "milestone"],
          "enumDescriptions": [
            "Preserve normal test execution behavior while the repeat-failure circuit breaker remains active.",
            "Block unscoped full test runs and direct the agent to run_affected_tests or a specific target.",
            "Allow full regression suites."
          ],
          "default": "manual",
          "scope": "resource",
          "description": "Zuma execution policy for the active workspace."
        },
        "inazumaPwsh.executionGuard.repeatFailureThreshold": {
          "type": "integer",
          "minimum": 2,
          "maximum": 10,
          "default": 3,
          "scope": "resource",
          "description": "Number of identical failures with the same command and Git diff before Zuma trips the circuit breaker."
        },
        "inazumaPwsh.executionGuard.historySeconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 3600,
          "default": 120,
          "scope": "resource",
          "description": "Retention window for repeat-failure detection."
        },
        "inazumaPwsh.executionGuard.skipRedPhase": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Block test execution when only test files changed, requiring an implementation change or an explicit gate reset."
        }
      }
    },
    "mcpServerDefinitionProviders": [
      { "id": "inazuma-pwsh.server", "label": "Zuma MCP" }
    ],
    "commands": [
      { "command": "inazumaPwsh.showSavings", "title": "Zuma MCP: Show Savings" },
      { "command": "inazumaPwsh.selectExecutionGateMode", "title": "Zuma MCP: Select Execution Gate Mode" },
      { "command": "inazumaPwsh.resetExecutionGate", "title": "Zuma MCP: Reset Execution Gate" }
    ]
  },
  "files": [
    "extension.js",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.txt",
    "media/icon.png",
    "server/**"
  ],
  "scripts": {
    "test": "node test-extension.cjs",
    "package": "vsce package --target win32-x64 --no-dependencies --out ../artifacts/zuma-mcp-0.12.1-win32-x64.vsix",
    "package:linux-x64": "vsce package --target linux-x64 --no-dependencies --out ../artifacts/zuma-mcp-0.12.1-linux-x64.vsix",
    "package:linux-arm64": "vsce package --target linux-arm64 --no-dependencies --out ../artifacts/zuma-mcp-0.12.1-linux-arm64.vsix",
    "package:darwin-x64": "vsce package --target darwin-x64 --no-dependencies --out ../artifacts/zuma-mcp-0.12.1-darwin-x64.vsix",
    "package:darwin-arm64": "vsce package --target darwin-arm64 --no-dependencies --out ../artifacts/zuma-mcp-0.12.1-darwin-arm64.vsix"
  },
  "devDependencies": {
    "@types/vscode": "1.101.0",
    "@vscode/vsce": "3.6.2"
  }
}
